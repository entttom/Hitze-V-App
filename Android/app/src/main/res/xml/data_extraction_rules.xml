<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Push topic state belongs to this installation's FCM token; the app
     re-subscribes from the restored worksites on first start. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/hitze_v_push_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/hitze_v_push_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
