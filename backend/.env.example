# --- required -------------------------------------------------------------
# Bearer secret for POST /cron/hitze and all develop data routes. `openssl rand -hex 32`
CRON_SECRET=replace-with-strong-secret
# JSON string with project_id, client_email and private_key (Firebase service account).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}
REDIS_URL=redis://default:<password>@<redis-host>:6379

# --- optional -------------------------------------------------------------
PORT=3000
# Minimum Hitze-V warning level that is pushed: 2 (yellow, default), 3 (orange) or 4 (red).
HITZE_MIN_LEVEL=2
# Legacy fan-out to warngebiet_<GKZ>_<lang>: all (default, 25 languages) | de | off
LEGACY_LANGUAGE_TOPICS=all
# Parallel FCM sends (1..500, default 50).
HITZE_FCM_SEND_CONCURRENCY=50
# Cron lock TTL in seconds (30..3600, default 300); refreshed every TTL/3 while a run is active.
HITZE_CRON_LOCK_TTL_SECONDS=300
# How long SIGTERM waits for a running cron before aborting its remaining sends (ms, default 4000).
HITZE_SHUTDOWN_TIMEOUT_MS=4000
# After the abort: how long to wait for sends already in flight to record their state (ms, default 5000).
HITZE_SHUTDOWN_ABORT_GRACE_MS=5000

# Develop mode: enables /test (HTML) and the authenticated /test/* API. Never in production.
DEVELOP=false

# Static feed for tests instead of the live GeoSphere API.
HITZE_USE_STATIC_GEOSPHERE_RESPONSE=false
# Local file (default: example_response.json in the working directory) ...
HITZE_STATIC_GEOSPHERE_FILE=
# ... or an explicit URL (wins over the file when set).
HITZE_STATIC_GEOSPHERE_URL=

# Pushover admin reports (run summary after sends, failure alerts at most once per hour per error).
# Both APP_TOKEN and USER_KEY must be set to enable.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Optional: limit delivery to one Pushover device name.
PUSHOVER_DEVICE=
# Default on/off for reports; the develop UI can override it (stored in Redis).
PUSHOVER_REPORTS_ENABLED=true
